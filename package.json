{
  "name": "sterenncours",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Supports de cours de 4e et portail de suivi, alignes sur le programme officiel du cycle 4.",
  "scripts": {
    "build": "node build/build.mjs",
    "pdf": "node build/pdf.mjs",
    "pdf:tout": "node build/pdf.mjs --tout",
    "all": "npm run build && npm run pdf",
    "serve": "node build/serve.mjs",
    "test": "node --test tests/unitaires.mjs && node tests/preparer.mjs && node tests/lancer.mjs",
    "test:unit": "node --test tests/unitaires.mjs",
    "verifier": "node build/verifier.mjs",
    "lint": "eslint site functions build tests",
    "audit:jeux": "node tests/jeux.mjs",
    "audit:visuel": "node tests/visuel.mjs",
    "audit:visuel:reference": "node tests/visuel.mjs --reference",
    "audit:contenus": "node build/audit-contenus.mjs"
  },
  "dependencies": {
    "markdown-it": "^15.0.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^3.0.0"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "playwright-core": "^1.49.0",
    "sharp": "^0.35.4",
    "wrangler": "^4.0.0"
  }
}
