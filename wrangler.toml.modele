# Gabarit de configuration Cloudflare.
# build/provisionner.mjs crée les ressources si elles n'existent pas, puis écrit
# wrangler.toml en remplaçant les marqueurs ci-dessous par les identifiants réels.
# wrangler.toml n'est pas versionné : il contient des identifiants de compte.

name = "sterenncours"
compatibility_date = "2025-09-01"
pages_build_output_dir = "public"

[[kv_namespaces]]
binding = "SESSIONS"
id = "__KV_ID__"

[[d1_databases]]
binding = "DB"
database_name = "sterenncours"
database_id = "__D1_ID__"

[[r2_buckets]]
binding = "FICHIERS"
bucket_name = "sterenncours-fichiers"
